<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel Margin="10">
        <WrapPanel HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,1,0,10">
            <Button x:Name="btnOpenFile" Click="btnOpenFile_Click" Height="28" Width="111" Content="Open file"/>
            <Button x:Name="UploadButton" Content="Upload File" HorizontalAlignment="Left" VerticalAlignment="Top" Click="UploadButton_Click" Height="28" Width="111" RenderTransformOrigin="0.369,1.146"/>
            <TextBox x:Name="txtPath" TextWrapping="Wrap" Width="447"/>
        </WrapPanel>
        <TextBox Name="txtEditor" />
    </DockPanel>
</Window>
